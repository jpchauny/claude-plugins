{
  "extraKnownMarketplaces": {
    "jpchauny-plugins": {
      "source": {
        "source": "github",
        "repo": "jpchauny/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "utilities@jpchauny-plugins": true,
    "specs-management@jpchauny-plugins": true
  },
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git * commit *)",
      "Bash(git * push *)"
    ]
  }
}
